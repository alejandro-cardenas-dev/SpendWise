# Copy to .env (git-ignored) before running `docker compose up`.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Use this generator, not Django's: its output can contain `$`, which
# Docker Compose treats as a variable and silently corrupts.
SECRET_KEY=

# Letters and digits only: it is embedded in a connection URL
POSTGRES_PASSWORD=

# Optional overrides
# POSTGRES_DB=spendwise
# POSTGRES_USER=spendwise
# NEXT_PUBLIC_API_URL=http://localhost:8000/api